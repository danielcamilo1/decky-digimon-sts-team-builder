{
  "name": "decky-digimon-sts-team-builder",
  "version": "1.3.0",
  "description": "Digimon Story: Time Stranger team builder for Decky Loader",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "prepare-data": "node scripts/prepare-data.mjs",
    "package": "rollup -c && python3 scripts/package.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielcamilo1/decky-digimon-sts-team-builder.git"
  },
  "keywords": [
    "decky",
    "steam-deck",
    "digimon",
    "time-stranger",
    "team-builder"
  ],
  "author": "danielvergara",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "^4.53.3",
    "rollup-plugin-copy": "^3.5.0",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  },
  "homepage": "https://github.com/danielcamilo1/decky-digimon-sts-team-builder#readme",
  "bugs": {
    "url": "https://github.com/danielcamilo1/decky-digimon-sts-team-builder/issues"
  }
}
